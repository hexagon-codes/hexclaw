{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HexClaw homework report render input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "branding",
    "source_images",
    "questions",
    "deep",
    "source_text"
  ],
  "properties": {
    "schema_version": {
      "const": "homework-report-render-v2"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "agent_name",
        "grade_term",
        "subject",
        "date",
        "source_kind"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "agent_name": {
          "type": "string"
        },
        "grade_term": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "example_label": {
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "grading",
            "text_solve"
          ]
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagline",
        "website_url",
        "website_label",
        "wechat_id",
        "github_url",
        "github_label"
      ],
      "properties": {
        "logo_path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "website_url": {
          "type": "string"
        },
        "website_label": {
          "type": "string"
        },
        "wechat_id": {
          "type": "string"
        },
        "github_url": {
          "type": "string"
        },
        "github_label": {
          "type": "string"
        }
      }
    },
    "source_images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "deep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "application"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "application": {
              "type": "string"
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "title",
              "blocks"
            ],
            "properties": {
              "number": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            }
          }
        }
      }
    },
    "source_text": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "math_ref"
          ],
          "properties": {
            "kind": {
              "const": "math"
            },
            "math_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "alt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "status",
        "answer",
        "calculations",
        "original_answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "tone"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "tone": {
              "enum": [
                "amber",
                "green",
                "red",
                "neutral"
              ]
            }
          }
        },
        "answer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "calculations": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/inline"
            }
          }
        },
        "calculation_columns": {
          "enum": [
            1,
            2
          ]
        },
        "original_answer": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "content": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/inline"
                }
              }
            }
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "paragraph"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "supplement"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "application"
          ],
          "properties": {
            "kind": {
              "const": "method_note"
            },
            "name": {
              "type": "string"
            },
            "application": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "equation"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            },
            "size_pt": {
              "type": "number",
              "minimum": 9,
              "maximum": 15
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "alt"
          ],
          "properties": {
            "kind": {
              "const": "diagram"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "caption": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "note"
            },
            "label": {
              "type": "string"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "headers",
            "rows"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "headers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/inline"
                }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/inline"
                  }
                }
              }
            },
            "widths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "columns"
          ],
          "properties": {
            "kind": {
              "const": "columns"
            },
            "columns": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            },
            "widths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
